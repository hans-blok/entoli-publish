        <child xsi:type="archimate:DiagramObject" id="id-997eeb940fc547a79b807e8aa154e6e6" textPosition="1" archimateElement="id-bbcbfcd279104c52b55b4973d859dcdd">
          <bounds x="636" y="432" width="120" height="55"/>
          <sourceConnection xsi:type="archimate:Connection" id="id-bdb08d5b3b6a46bfa74b5b0b044f5829" source="id-997eeb940fc547a79b807e8aa154e6e6" target="id-607ae57960b848079492de0acfd5b662" archimateRelationship="id-af421ae7816e4b3482283107913e951f"/>
